{
  "name": "@ihub/plugin-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK and manifest contract for iHub plugins.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest.schema.json": "./manifest.schema.json"
  },
  "files": [
    "dist",
    "manifest.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && tsc --noEmit -p tests/tsconfig.json && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
