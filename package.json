{
  "name": "ihub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fast, extensible desktop launcher and local search hub.",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "dev:verify": "pnpm install --frozen-lockfile && pnpm check",
    "generate:official-plugin-lock": "node scripts/generate-official-plugin-lock.mjs",
    "build": "tsc -b && vite build",
    "build:local": "tauri build --no-bundle",
    "bootstrap:official-plugins": "node scripts/bootstrap-official-plugins.mjs --locked",
    "check": "tsc -b",
    "verify:macos-bundle-policy": "node scripts/verify-macos-bundle-policy.mjs",
    "verify:official-plugin-builds": "node scripts/verify-official-plugin-builds.mjs",
    "verify:official-plugins": "node scripts/verify-official-plugin-lock.mjs",
    "update:official-plugins": "node scripts/bootstrap-official-plugins.mjs --update-if-clean",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.11.3",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "6.0.2",
    "jsqr": "1.4.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
