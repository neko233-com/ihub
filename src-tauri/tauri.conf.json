{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iHub",
  "mainBinaryName": "ihub",
  "version": "0.1.0",
  "identifier": "com.neko233.ihub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "iHub",
        "width": 1200,
        "height": 756,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "focus": true,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "theme": "Dark",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "frame-src": "http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/neko233-com/ihub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NzZCRDk2MjdBNEJCRDcKUldUWHU2UW5scjEybDJTWmh1U25xWng4Mi9GT1VwcUZ5TURxN2hXb0ZGYXZ3clJ6cWxEUU0zUlQK"
    }
  }
}
