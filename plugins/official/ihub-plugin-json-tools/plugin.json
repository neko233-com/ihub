{
  "$schema": "https://ihub.dev/schemas/plugin-manifest-v1.json",
  "schemaVersion": 1,
  "id": "ihub-plugin-json-tools",
  "name": "JSON Tools",
  "version": "0.1.0",
  "description": "Format, validate, query, convert, and copy JSON without leaving the launcher.",
  "author": "iHub",
  "license": "MIT",
  "repository": "https://github.com/neko233-com/ihub-plugin-json-tools",
  "engines": { "ihub": ">=0.1.0", "api": "^1.0.0" },
  "entry": { "frontend": "dist/index.html" },
  "activationEvents": ["onCommand:open-json-tools", "onFile:json", "onSearch"],
  "contributes": {
    "commands": [
      { "id": "open-json-tools", "title": "Open JSON tools", "keywords": ["json", "format", "validate", "jq"] }
    ],
    "searchProviders": [
      { "id": "json-actions", "title": "JSON tools", "trigger": "json ", "priority": 20 }
    ]
  },
  "permissions": {
    "filesystem": { "read": ["user-selected"], "write": ["user-selected"] },
    "clipboard": { "read": true, "write": true }
  },
  "update": { "channel": "stable", "autoUpdate": true }
}
