{
  "$schema": "https://ihub.dev/schemas/plugin-manifest-v1.json",
  "schemaVersion": 1,
  "id": "ihub-plugin-screenshot",
  "name": "Screenshot",
  "version": "0.1.0",
  "description": "Capture, annotate, copy, or save a region of the current screen.",
  "author": "iHub",
  "license": "MIT",
  "repository": "https://github.com/neko233-com/ihub-plugin-screenshot",
  "engines": { "ihub": ">=0.1.0", "api": "^1.0.0" },
  "entry": { "frontend": "dist/index.html" },
  "backend": {
    "protocol": "jsonl-rpc-v1",
    "restart": "never",
    "binaries": [
      { "target": "windows-x86_64", "path": "bin/windows-x86_64/screenshot-worker.exe" },
      { "target": "windows-aarch64", "path": "bin/windows-aarch64/screenshot-worker.exe" },
      { "target": "darwin-x86_64", "path": "bin/darwin-x86_64/screenshot-worker" },
      { "target": "darwin-aarch64", "path": "bin/darwin-aarch64/screenshot-worker" }
    ]
  },
  "activationEvents": ["onCommand:capture-screen"],
  "contributes": {
    "commands": [
      { "id": "capture-screen", "title": "Capture screenshot", "keywords": ["screenshot", "screen", "capture"] }
    ]
  },
  "permissions": {
    "filesystem": { "write": ["user-selected"] },
    "clipboard": { "write": true },
    "globalShortcut": true,
    "nativeApi": true,
    "notifications": true
  },
  "update": { "channel": "stable", "autoUpdate": true }
}
