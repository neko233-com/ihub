{
  "$schema": "https://ihub.dev/schemas/plugin-manifest-v1.json",
  "schemaVersion": 1,
  "id": "ihub-plugin-clipboard",
  "name": "Clipboard History",
  "version": "0.1.0",
  "description": "Search, pin, and reuse clipboard history from the launcher.",
  "author": "iHub",
  "license": "MIT",
  "repository": "https://github.com/neko233-com/ihub-plugin-clipboard",
  "engines": { "ihub": ">=0.1.0", "api": "^1.0.0" },
  "entry": { "frontend": "dist/index.html" },
  "activationEvents": ["onStartup", "onCommand:open-clipboard-history", "onSearch"],
  "contributes": {
    "commands": [
      { "id": "open-clipboard-history", "title": "Open clipboard history", "keywords": ["clipboard", "paste", "history"] }
    ],
    "searchProviders": [
      { "id": "clipboard-history", "title": "Clipboard history", "trigger": "clip ", "priority": 35 }
    ],
    "settings": [
      { "key": "maxItems", "title": "Maximum history items", "type": "number", "default": 200 },
      { "key": "excludeSensitive", "title": "Exclude likely sensitive values", "type": "boolean", "default": true }
    ]
  },
  "permissions": {
    "filesystem": { "write": ["plugin-data"] },
    "clipboard": { "read": true, "write": true },
    "nativeApi": true,
    "notifications": true
  },
  "update": { "channel": "stable", "autoUpdate": true }
}
