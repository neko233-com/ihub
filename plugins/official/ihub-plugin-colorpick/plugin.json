{
  "$schema": "https://ihub.dev/schemas/plugin-manifest-v1.json",
  "schemaVersion": 1,
  "id": "ihub-plugin-colorpick",
  "name": "Color Picker",
  "version": "0.1.0",
  "description": "Pick a screen color and copy HEX, RGB, HSL, or CSS values.",
  "author": "iHub",
  "license": "MIT",
  "repository": "https://github.com/neko233-com/ihub-plugin-colorpick",
  "engines": { "ihub": ">=0.1.0", "api": "^1.0.0" },
  "entry": { "frontend": "dist/index.html" },
  "backend": {
    "protocol": "jsonl-rpc-v1",
    "restart": "never",
    "binaries": [
      { "target": "windows-x86_64", "path": "bin/windows-x86_64/colorpick-worker.exe" },
      { "target": "windows-aarch64", "path": "bin/windows-aarch64/colorpick-worker.exe" },
      { "target": "darwin-x86_64", "path": "bin/darwin-x86_64/colorpick-worker" },
      { "target": "darwin-aarch64", "path": "bin/darwin-aarch64/colorpick-worker" }
    ]
  },
  "activationEvents": ["onCommand:pick-color"],
  "contributes": {
    "commands": [
      { "id": "pick-color", "title": "Pick screen color", "keywords": ["color", "colour", "hex", "rgb"] }
    ]
  },
  "permissions": {
    "clipboard": { "write": true },
    "globalShortcut": true,
    "nativeApi": true,
    "notifications": true
  },
  "update": { "channel": "stable", "autoUpdate": true }
}
