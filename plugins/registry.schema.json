{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihub.dev/schemas/plugin-registry-v1.json",
  "title": "iHub plugin registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "packages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "source", "channels", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "defaultRef", "manifest"],
          "properties": {
            "type": { "const": "git" },
            "url": { "type": "string", "format": "uri" },
            "defaultRef": { "type": "string", "minLength": 1 },
            "manifest": { "type": "string", "minLength": 1 }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "minProperties": 1
        },
        "supportedTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["windows-x86_64", "windows-aarch64", "darwin-x86_64", "darwin-aarch64"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "status": { "enum": ["bootstrap", "available", "deprecated"] }
      }
    }
  }
}
